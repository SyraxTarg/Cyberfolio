{% extends 'base.html.twig' %}

{% block title %}Experiences{% endblock %}

{% block body %}
    <h1>Experiences</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ experience.id }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ experience.Titre }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ experience.Description }}</td>
            </tr>
            <tr>
                <th>Lieu</th>
                <td>{{ experience.Lieu }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ experience.Date ? experience.Date|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_experiences_index') }}">back to list</a>

    <a href="{{ path('app_experiences_edit', {'id': experience.id}) }}">edit</a>

    {{ include('experiences/_delete_form.html.twig') }}
{% endblock %}
