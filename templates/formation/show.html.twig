{% extends 'base.html.twig' %}

{% block title %}Formation{% endblock %}

{% block body %}
    <h1>Formation</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ formation.id }}</td>
            </tr>
            <tr>
                <th>Diplome</th>
                <td>{{ formation.Diplome }}</td>
            </tr>
            <tr>
                <th>Etablissement</th>
                <td>{{ formation.Etablissement }}</td>
            </tr>
            <tr>
                <th>Lieu</th>
                <td>{{ formation.Lieu }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ formation.Date ? formation.Date|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ formation.Description }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_formation_index') }}">back to list</a>

    <a href="{{ path('app_formation_edit', {'id': formation.id}) }}">edit</a>

    {{ include('formation/_delete_form.html.twig') }}
{% endblock %}
