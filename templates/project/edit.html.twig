{% extends 'base.html.twig' %}

{% block title %}Edit Project{% endblock %}
{%  block stylesheets %}
    <link href="{{ asset('styles/project/projectEdit.css') }}" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
{% endblock %}

{% block body %}
    {{ parent() }}
    <h1>Edit Project</h1>
    <div id="editForm">
        {{ form_start(form) }}
        <img src="{{ asset('images/projects/' ~ project.screenshot) }}" alt="screenshot" id="screenshot">
        <div class="formFields">
            {{ form_label(form.screenshot) }}
            {{ form_widget(form.screenshot) }}
        </div>
        <hr>
        <div class="formFields">
            {{ form_label(form.title) }}
            {{ form_widget(form.title) }}
        </div>
        <hr>
        <div class="formFields">
            {{ form_label(form.description) }}
            {{ form_widget(form.description) }}
        </div>
        <hr>
        <div class="formFields">
            {{ form_label(form.technologies) }}
            <div id="technologies">
                {{ form_widget(form.technologies) }}
                <a href="{{ path('app_technology_new_from_project', {'projectId': project.id}) }}" id="addTech">add a tech</a>
            </div>
        </div>
        <hr>
        <div class="formFields">
            {{ form_label(form.link) }}
            {{ form_widget(form.link) }}
        </div>

        <div id="formActions">
            <button class="btn">{{ button_label|default('Update') }}</button>
            {{ form_end(form) }}
            <a href="{{ path('app_project_index') }}">back to list</a>
        </div>

    </div>



{% endblock %}
