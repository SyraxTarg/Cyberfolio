{% extends 'base.html.twig' %}

{% block title %}New Technology{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('styles/technology/newTech.css') }}" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
{% endblock %}

{% block body %}
    {{ parent() }}
    <div id="form-container">
        <div class="form">
            <p class="form-title">Create new Technology</p>

            {{ form_start(form) }}

            <div class="input-container">
                {{ form_row(form.logo) }}
            </div>
            <div class="input-container">
                {{ form_row(form.name) }}
            </div>
            <div class="input-container">
                {{ form_row(form.version) }}
            </div>

            <button class="btn btn-lg btn-primary submit">{{ button_label|default('Save') }}</button>

            <a href="{{ path('app_technology_index') }}" id="backToList">back to list</a>

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
