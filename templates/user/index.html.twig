{% extends 'base.html.twig' %}

{% block title %}User index{% endblock %}
{%  block stylesheets %}
    <link href="{{ asset('styles/user/userIndex.css') }}" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
{% endblock %}

{% block body %}
    {{ parent() }}
    <div class="container mt-4">
        <div class="card shadow-lg">
            <div class="card-header bg-primary text-white text-center">
                <h1 class="mb-0">User Index</h1>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-dark">
                        <tr>
                            <th scope="col">Id</th>
                            <th scope="col">Firstname</th>
                            <th scope="col">Lastname</th>
                            <th scope="col">Email</th>
                            <th scope="col">Roles</th>
                            <th scope="col">Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for user in users %}
                            <tr>
                                <td>{{ user.id }}</td>
                                <td>{{ user.firstname }}</td>
                                <td>{{ user.lastname }}</td>
                                <td>{{ user.email }}</td>
                                <td>{{ user.roles ? user.roles|json_encode : '' }}</td>
                                <td>
                                    <div class="btn-group user-actions" role="group">
                                        <a href="{{ path('app_user_show', {'id': user.id}) }}" class="btn btn-primary btn-sm">Show</a>
                                        {% if app.user and "ROLE_SUPER_ADMIN" in app.user.roles %}
                                            <a href="{{ path('app_give_roles', {'id': user.id}) }}" class="btn btn-info btn-sm">Manage Roles</a>
                                        {% endif %}
                                        {% if app.user and ("ROLE_SUPER_ADMIN" in app.user.roles or "ROLE_ADMIN" in app.user.roles) %}
                                            <a href="{{ path('app_user_delete', {'id': user.id}) }}" class="btn btn-danger btn-sm"><i class="fa-solid fa-trash"></i></a>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center">No records found</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer text-end">
                <a href="{{ path('app_user_new') }}" class="btn btn-success">Create New</a>
            </div>
        </div>
    </div>
{% endblock %}
